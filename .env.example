# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection environment variables (injected at runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional: Default WhatsApp Webhook verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN="connectflow_verify_token"
